{
  "name": "@nemesis-oss/ci-agent-core",
  "version": "0.1.1",
  "description": "Repo-agnostic CI agent core: ports, policy engine, manifest, task router, and review/fix/scan orchestrators. Deterministic tools first; LLM advisory layer isolated behind a fail-closed port.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "yaml": "^2.9.0"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shubhamtaywade82/ci-agent.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/shubhamtaywade82/ci-agent#readme",
  "bugs": {
    "url": "https://github.com/shubhamtaywade82/ci-agent/issues"
  }
}
