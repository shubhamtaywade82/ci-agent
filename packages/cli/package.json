{
  "name": "@nemesis-oss/ci-agent",
  "version": "0.1.0",
  "description": "CI agent CLI: advisory review/fix/scan for any repository. Deterministic core, LLM advisory layer behind a fail-closed port, Ollama Cloud via @nemesis-oss/ollama-sdk.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ci-agent": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nemesis-oss/ci-agent-core": "^0.1.0",
    "@nemesis-oss/ci-agent-ollama-cloud": "^0.1.0",
    "@nemesis-oss/ci-agent-github": "^0.1.0",
    "@nemesis-oss/ci-agent-toolchains": "^0.1.0",
    "@nemesis-oss/ollama-sdk": "^1.26.0",
    "yaml": "^2.9.0"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shubhamtaywade82/ci-agent.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/shubhamtaywade82/ci-agent#readme",
  "bugs": {
    "url": "https://github.com/shubhamtaywade82/ci-agent/issues"
  }
}
